generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum MessageStatus {
  OPEN
  BOT_HANDLED
  NEEDS_HUMAN
  CLAIMED
  CLOSED
}

/// Where a conversation came from: the storefront widget, or a WishKeeper
/// merchant's in-admin support chat (synced from the WishKeeper app's own DB).
enum MessageSource {
  WIDGET
  WISHKEEPER
  // Any other Shopify app wired up via the generic EmbeddedApp integration
  // (same contract WishKeeper uses, just not hardcoded to one app).
  EMBEDDED
}

enum ReplySender {
  ADMIN
  SHOP
  BOT
  // Not a chat participant -- a divider row (e.g. "new conversation
  // started"), rendered without a bubble in the dashboard.
  SYSTEM
}

model Admin {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  assignedMessages Message[]      @relation("AssignedAdmin")
  replies          MessageReply[]
}

/// One row per connected Shopify app/store this backend serves.
model ShopifyApp {
  id          Int      @id @default(autoincrement())
  name        String
  shop        String   @unique // e.g. some-store.myshopify.com
  accessToken String   @db.Text // Shopify Admin API access token for this shop
  scriptTagId String? // Shopify ScriptTag id once registered (installMethod "scripttag")
  // "scripttag" | "theme" | null (not installed yet). Newer apps can no
  // longer create ScriptTags at all (Shopify now requires a theme app
  // extension for that), so install falls back to writing the widget
  // directly into the active theme's layout file instead.
  installMethod String?
  createdAt   DateTime @default(now())

  keywords BotKeyword[]
  messages Message[]
}

/// Per-app FAQ keyword -> answer entries used by the rule-based bot.
model BotKeyword {
  id        Int        @id @default(autoincrement())
  appId     Int
  app       ShopifyApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  keyword   String
  answer    String     @db.Text
  createdAt DateTime   @default(now())

  @@index([appId])
}

model Message {
  id               Int           @id @default(autoincrement())
  appId            Int? // null for WISHKEEPER conversations, which aren't tied to a widget store
  app              ShopifyApp?   @relation(fields: [appId], references: [id], onDelete: Restrict)
  embeddedAppId    Int? // which connected EmbeddedApp this conversation belongs to, for EMBEDDED conversations
  embeddedApp      EmbeddedApp?  @relation(fields: [embeddedAppId], references: [id], onDelete: SetNull)
  source           MessageSource @default(WIDGET)
  externalThreadId String?       @unique // WishKeeper SupportThread.id, for WISHKEEPER conversations
  shop             String
  visitorId        String // stable id the widget stores in localStorage to resume a thread
  name             String?
  email            String?
  subject          String?
  body             String        @db.Text
  status           MessageStatus @default(OPEN)
  archived         Boolean       @default(false)
  starred          Boolean       @default(false)
  snoozedUntil     DateTime? // hidden from the default inbox until this time, or until the customer replies (whichever first)
  csatScore        Int? // 1-5, submitted once by the customer after close -- WIDGET conversations only
  csatSubmittedAt  DateTime?
  assignedAdminId  Int?
  assignedAdmin    Admin?        @relation("AssignedAdmin", fields: [assignedAdminId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  // Below: polling support for EMBEDDED apps with no database of their own
  // (see EmbeddedApp.databaseUrl) -- the merchant's widget polls these
  // directly on this same Message row instead of a mirrored copy.
  adminTypingAt    DateTime? // admin is typing right now, for the merchant's widget to show live
  embeddedResetAt  DateTime? // merchant clicked "start new chat" -- hides everything before this from THEIR widget only; admins still see full history here

  replies MessageReply[]

  @@index([appId, status])
  @@index([visitorId])
}

model MessageReply {
  id          Int         @id @default(autoincrement())
  messageId   Int
  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sender      ReplySender
  adminId     Int?
  admin       Admin?      @relation(fields: [adminId], references: [id])
  adminName   String?
  body        String      @db.Text
  attachments Json?
  externalId  String?     @unique // WishKeeper SupportMessage.id, used to de-duplicate synced messages
  internal    Boolean     @default(false) // admin-only note -- never pushed to the customer or WishKeeper
  createdAt   DateTime    @default(now())

  @@index([messageId])
}

/// Shared quick-insert replies available to every admin in the composer.
model CannedReply {
  id        Int      @id @default(autoincrement())
  shortcut  String   @unique // e.g. "refund" -- shown in the picker, not typed as a slash command
  body      String   @db.Text
  createdAt DateTime @default(now())
}

/// A Shopify app connected via the generic embedded-chat integration (the
/// same contract WishKeeper uses, generalized so any app can register
/// instead of needing bespoke code here per app). One row per connected
/// APP (not per shop) -- any shop that installs that app reaches this same
/// row, identified by its secret rather than by a specific shop, exactly
/// like WishKeeper's own dedicated integration serves every shop that
/// installs WishKeeper from one shared connection.
///
/// databaseUrl is optional: when set, this app keeps its own mirrored copy
/// of the conversation (old path -- e.g. ConvoBridge) and Supportly reaches
/// into that database directly. When null, this app has no database of its
/// own for chat at all -- everything lives only in Supportly's own
/// Message/MessageReply rows, and the app's widget talks straight to the
/// /embedded/thread/* endpoints instead. Simpler to connect (no database to
/// create), at the cost of the merchant's chat depending on Supportly being up.
model EmbeddedApp {
  id               Int       @id @default(autoincrement())
  name             String
  databaseUrl      String?   @db.Text // that app's own DB connection string, or null for the DB-less path
  appUrl           String // where to push replies/typing -- self-updates via /internal/register-url
  internalSecret   String    @unique // this app's own secret, not shared with any other -- also how inbound requests are identified
  adminDisplayName String    @default("Support")
  createdAt        DateTime  @default(now())
  conversations    Message[]
}
