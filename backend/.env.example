PORT=4000
DATABASE_URL="mysql://user:password@localhost:3306/chat_support"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS - comma separated list of allowed origins (admin dashboard + storefronts)
CORS_ORIGINS="http://localhost:5173"

# Public URL this backend is reachable at (used when registering the ScriptTag)
BACKEND_PUBLIC_URL="http://localhost:4000"

# SMTP settings used to email admins when a conversation needs a human
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="change-me"
MAIL_FROM="Support Bot <support@example.com>"

# Bootstrap super admin, created automatically on first boot if no admins exist
BOOTSTRAP_SUPER_ADMIN_EMAIL="owner@example.com"
BOOTSTRAP_SUPER_ADMIN_PASSWORD="change-me-now"
BOOTSTRAP_SUPER_ADMIN_NAME="Owner"

# Shopify apps/stores to auto-register on every boot (upserted by shop, so
# editing this + restarting is enough to add an app or rotate its token —
# no need to go through the OAuth install webhook or the dashboard).
# JSON array of { name, shop, accessToken }. Leave unset / "[]" to skip.
SEED_APPS='[{"name":"Demo Shop","shop":"demo-shop.myshopify.com","accessToken":"shpat_xxxxxxxx"}]'

# --- WishKeeper merchant support chat -------------------------------------
# Lets this backend replace the old standalone "WishKeeper Admin Dashboard":
# merchants' in-app support threads show up in this inbox. Enabled only when
# WISHKEEPER_DATABASE_URL and SUPPORT_INTERNAL_SECRET are both set.
# On the WishKeeper side, set ADMIN_DASHBOARD_URL to this backend's URL
# (e.g. http://localhost:4000) — nothing else there needs to change.

# WishKeeper's own database (same value as DATABASE_URL in wishkeeperv2/.env).
WISHKEEPER_DATABASE_URL="mysql://user:password@127.0.0.1:3306/wish_wihkeeperv2"
# Must match SUPPORT_INTERNAL_SECRET in wishkeeperv2/.env exactly.
SUPPORT_INTERNAL_SECRET="change-me-shared-secret"
# Where WishKeeper is reachable (for live reply/typing push and merchant
# attachments). In local dev its server announces its random port to us
# automatically, so this is only the starting value.
WISHKEEPER_APP_URL="https://wishkeeper.example.com"
# Name shown for replies imported from the old standalone dashboard.
WISHKEEPER_ADMIN_DISPLAY_NAME="WishKeeper Support"
